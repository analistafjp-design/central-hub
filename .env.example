# ============================================================
# Central Hub - Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha com os valores do
# seu projeto Supabase (Project Settings > API).
# ============================================================

# URL do projeto Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" do Supabase (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=

# Nome exibido da aplicação (opcional)
VITE_APP_NAME=Central Hub
